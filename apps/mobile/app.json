{
  "expo": {
    "name": "St. Michael's Cathedral",
    "slug": "st-michaels-cathedral-coimbatore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stmichaels",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.stmichaelscathedral.parish",
      "supportsTablet": true
    },
    "android": {
      "package": "in.stmichaelscathedral.parish",
      "adaptiveIcon": {
        "backgroundColor": "#8C1D2C",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8C1D2C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
