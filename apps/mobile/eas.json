{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true
    },
    "st-michaels-coimbatore-preview": {
      "extends": "preview",
      "env": { "PARISH": "st-michaels-coimbatore" }
    },
    "st-michaels-coimbatore-production": {
      "extends": "production",
      "env": { "PARISH": "st-michaels-coimbatore" }
    }
  },
  "submit": {
    "production": {}
  }
}
