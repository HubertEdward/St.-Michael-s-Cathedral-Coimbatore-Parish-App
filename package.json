{
  "name": "parish-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "parishes"
  ],
  "scripts": {
    "mobile": "npm run start -w @parish/mobile",
    "admin": "npm run web -w @parish/admin",
    "demo": "node demo/run.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:reset": "supabase db reset",
    "backend:samples": "tsx --require ./scripts/parish-node.cjs scripts/load-samples.ts",
    "backend:test": "tsx --test supabase/tests/rules.test.ts",
    "backend:env": "tsx scripts/local-env.ts"
  },
  "devDependencies": {
    "supabase": "2.122.1",
    "tsx": "4.23.15"
  }
}
